{
    "type": "module",
    "scripts": {
        "dev": "concurrently \"pnpm dev:backend\" \"vite\" -n \"server,frontend\" -c \"magenta,green\"",
        "dev:backend": "node --watch --env-file=./src/backend/.env ./src/backend/main.js",
        "prod:backend": "node --env-file=./src/backend/.env ./src/backend/main.js",
        "build": "vite build",
        "preview": "npm run build && (vite preview|pnpm prod:backend)",
        "lint": "eslint ."
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@zumer/snapdom": "^3.3.4",
        "express": "^5.3.0",
        "lowdb": "^7.0.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^10.0.6",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "vite": "^6.4.4",
        "vite-plugin-pwa": "^2.0.0"
    }
}